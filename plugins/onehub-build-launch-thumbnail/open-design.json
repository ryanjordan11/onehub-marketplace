{
  "$schema": "https://open-design.ai/schemas/plugin.v1.json",
  "specVersion": "1.0.0",
  "name": "onehub-build-launch-thumbnail",
  "title": "OneHub Build Launch Thumbnail",
  "version": "1.0.0",
  "description": "Create a high-energy square launch thumbnail for a OneHub build, product announcement, or tutorial.",
  "license": "MIT",
  "author": {
    "name": "OneHub",
    "url": "https://github.com/ryanjordan11/onehub-marketplace"
  },
  "homepage": "https://github.com/ryanjordan11/onehub-marketplace",
  "tags": [
    "image-template",
    "onehub",
    "thumbnail",
    "launch",
    "social-media"
  ],
  "od": {
    "kind": "scenario",
    "taskKind": "new-generation",
    "mode": "image",
    "scenario": "image",
    "surface": "image",
    "preview": {
      "type": "image",
      "poster": "./assets/preview.png"
    },
    "useCase": {
      "query": {
        "en": "Create a OneHub build-launch thumbnail using the supplied subject photo and copy. Keep the person recognizable on the right. Use a black background with electric-blue interface lighting. Put highly legible, oversized white and yellow text on the left. The composition must be square, high contrast, cinematic, and readable at small thumbnail size."
      }
    },
    "inputs": [
      {
        "name": "subjectPhoto",
        "label": "Subject photo",
        "type": "media:image",
        "required": true,
        "placeholder": "Upload the person to feature"
      },
      {
        "name": "kicker",
        "label": "Top line",
        "type": "string",
        "default": "WATCH ME"
      },
      {
        "name": "headline",
        "label": "Headline",
        "type": "string",
        "default": "BUILD 2 COMPLETE CONTENT SYSTEMS"
      },
      {
        "name": "callout",
        "label": "Callout",
        "type": "string",
        "default": "IN 15 MINUTES"
      }
    ],
    "pipeline": {
      "stages": [
        {
          "id": "generate",
          "atoms": ["image-generate"]
        }
      ]
    },
    "capabilities": ["prompt:inject", "media:image-generate"],
    "category": "social-media-thumbnail"
  }
}
