{
  "$schema": "https://open-design.ai/schemas/plugin.v1.json",
  "specVersion": "1.0.0",
  "name": "onehub-brand-deck",
  "title": "OneHub Brand Deck",
  "version": "1.0.0",
  "description": "Interactive OneHub brand deck.",
  "license": "MIT",
  "author": { "name": "OneHub", "url": "https://github.com/ryanjordan11/onehub-marketplace" },
  "od": {
    "kind": "skill", "taskKind": "new-generation", "mode": "slides", "surface": "slides",
    "preview": { "type": "html", "entry": "index.html", "motion": "static" },
    "useCase": { "query": { "en": "Use the OneHub Brand Deck as the starting point for my brand presentation." }, "exampleOutputs": [{ "path": "index.html", "title": "OneHub Brand Deck" }] },
    "context": { "assets": ["./index.html"] },
    "capabilities": ["prompt:inject", "fs:read", "fs:write"]
  }
}
